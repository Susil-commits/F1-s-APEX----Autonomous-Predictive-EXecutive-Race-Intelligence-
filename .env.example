# APEX Race Intelligence - Environment Configuration Template
# Copy to .env and configure for your local or production environment.

# Database & Storage
POSTGRES_USER=apex_user
POSTGRES_PASSWORD=apex_password
POSTGRES_DB=apex_db
DATABASE_URL=postgresql+asyncpg://apex_user:apex_password@localhost:5432/apex_db
REDIS_URL=redis://localhost:6379/0

# API & Security
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000,http://localhost:3000

# Telemetry / Optional API Keys
# FASTF1_CACHE_DIR=backend/data/fastf1_cache
